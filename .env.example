# Скопируйте в .env и заполните. НИКОГДА не публикуйте .env на GitHub.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/eureka
# Длинная случайная строка (32+ символов)
JWT_SECRET=change-me-to-a-long-random-string
# Код, по которому учитель может зарегистрироваться (придумайте свой)
TEACHER_CODE=change-me-teacher-code
# Для seed-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
